<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.chronotone</groupId>
    <artifactId>chronotone-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>chronotone-cli</artifactId>
  <name>Chronotone CLI</name>
  <description>init / demo / render / verify — the entry point for humans.</description>

  <dependencies>
    <dependency>
      <groupId>dev.chronotone</groupId>
      <artifactId>chronotone-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chronotone</groupId>
      <artifactId>chronotone-dsl</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chronotone</groupId>
      <artifactId>chronotone-render</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chronotone</groupId>
      <artifactId>chronotone-connectors</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.chronotone.cli.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
